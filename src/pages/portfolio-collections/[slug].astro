---
/* Layers three and four: one gallery (its sub galleries, then its photos) or
   one sub gallery (its photos), at the address his Wix site used
   (/portfolio-collections/<slug>), inside its album. Built from what Matthew
   publishes in WVR Studio. The photos come straight after a short heading; then the review
   from that client, if there is one, the way to book the same kind of shoot,
   and the neighbouring galleries. Title and description are built so they
   always fit search limits, whatever he types. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import SectionHead from '../../components/SectionHead.astro';
import CollectionCards from '../../components/CollectionCards.astro';
import ContactBand from '../../components/ContactBand.astro';
import Icon from '../../components/Icon.astro';
import { albumOf, albumPath, COLLECTIONS, collectionPath, GALLERIES, parentOf, type Collection } from '../../data/collections';
import { REVIEWS } from '../../data/reviews';
import { service } from '../../data/services';
import { href } from '../../lib/paths';
import { breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Collection };
const s = service(c.service);
const album = albumOf(c);
const parent = parentOf(c);
// the next ones beside it first (in the same gallery, or the same album), then the rest of the portfolio
const sisters = (parent ? parent.subs : album.galleries).filter((g) => g !== c);
const others = [...sisters, ...(parent ? [parent] : []), ...GALLERIES.filter((g) => g.album !== c.album)].slice(0, 3);
const home = parent ? { title: parent.title, path: collectionPath(parent) } : { title: album.title, path: albumPath(album) };
const path = collectionPath(c);
const crumbs = [
  { name: 'Galleries', path: '/portfolio/' },
  { name: album.title, path: albumPath(album) },
  ...(parent ? [{ name: parent.title, path: collectionPath(parent) }] : []),
  { name: c.title, path },
];
const KIND = { events: 'Event', products: 'Product', portraits: 'Portrait or headshot' } as const;
const review = REVIEWS.find((r) => r.collection === c.slug);

function clamp(text: string, max: number) {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(' ') > 40 ? cut.lastIndexOf(' ') : cut.length).replace(/[\s,.;:]+$/, '')}…`;
}

// the project details from the studio, like his Wix project pages: type of work, date, place
const when = c.date ? new Date(`${c.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
const facts = [
  { label: 'Project type', value: c.kind },
  { label: 'Date', value: when },
  { label: 'Location', value: c.location },
].filter((f) => f.value);

const brand = ' | WVR Photography';
const longTitle = `${c.title} Gallery${brand}`;
const title = longTitle.length < 25 ? `${c.title} Gallery${brand}, Fenton MI` : longTitle.length <= 70 ? longTitle : `${clamp(c.title, 70 - brand.length)}${brand}`;

const tail = 'Photographed by Matthew Weaver of WVR Photography in Fenton, MI.';
const count = `${c.subs.length ? `${c.subs.length} ${c.subs.length === 1 ? 'gallery' : 'galleries'} and ` : ''}${c.photoCount} ${c.photoCount === 1 ? 'photo' : 'photos'}`;
const lead = c.blurb ? `${c.blurb.replace(/[.!?]?$/, '.')} ${tail}` : `${c.title}, ${count} by Matthew Weaver of WVR Photography, an event, product and portrait photographer in Fenton, MI.`;
const description = clamp(lead.length >= 70 ? lead : `${lead} See the gallery and get a free quote.`, 160);
---

<Base title={title} description={description} path={path} schema={[breadcrumbs(crumbs)]}>
  <PageHead user kicker={c.kind} title={c.title} lede={c.blurb || undefined} crumbs={crumbs}>
    {
      (c.date || c.location) && (
        <dl class="facts fine rise d2">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.label === 'Date' ? <time datetime={c.date}>{f.value}</time> : f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </PageHead>

  {
    c.subs.length > 0 && (
      <section class="band--tight ink gal" aria-label={`Galleries in ${c.title}`}>
        <div class="wrap">
          <CollectionCards items={c.subs} eagerFirst />
        </div>
      </section>
    )
  }

  <section class="band--tight ink gal" aria-label={`${c.title} photos`}>
    <div class="wrap">
      {c.photos.length > 0 && <Gallery photos={c.photos} />}
      <div class="gal__end">
        <a class="arrow" href={href(home.path)}><Icon name="back" /><span>More in {home.title}</span></a>
        <a class="btn primary" href="#quote">Book a shoot like this<Icon name="arrow" class="arr" /></a>
      </div>
    </div>
  </section>

  {
    review && (
      <section class="band white" aria-labelledby="said">
        <div class="wrap narrow">
          <SectionHead id="said" eyebrow="From the client" title="What they said." layout="left" />
          <Reviews ids={[review.id]} />
        </div>
      </section>
    )
  }

  <ContactBand title="Planning a shoot like this? Let's **talk.**" intro={`Tell me about it and I will get back to you with a free quote. More on [${s.name.toLowerCase()}](${s.path}).`} kind={KIND[c.service]} />

  {
    others.length > 0 && (
      <section class="band paper" aria-labelledby="more">
        <div class="wrap">
          <SectionHead id="more" eyebrow="Keep looking" title={sisters.length ? `More in ${home.title}.` : 'More galleries.'} layout="left" />
          <CollectionCards items={others} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin-top: 1.5rem;
  }

  .facts dt {
    color: var(--on-ink-muted);
  }

  .facts dd {
    color: var(--on-ink);
    font-weight: 600;
  }

  .gal {
    padding-top: 0;
  }

  .gal__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-ink);
  }

  .narrow {
    max-width: 48rem;
  }
</style>
