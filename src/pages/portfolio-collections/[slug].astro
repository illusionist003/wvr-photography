---
/* One gallery, at the address his Wix site used
   (/portfolio-collections/<slug>). Built from what Matthew publishes in WVR
   Studio. The photos come straight after a short heading; then the review
   from that client, if there is one, the way to book the same kind of shoot,
   and the neighbouring galleries. Title and description are built so they
   always fit search limits, whatever he types. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import SectionHead from '../../components/SectionHead.astro';
import CollectionCards from '../../components/CollectionCards.astro';
import ContactBand from '../../components/ContactBand.astro';
import Icon from '../../components/Icon.astro';
import { COLLECTIONS, collectionPath, type Collection } from '../../data/collections';
import { REVIEWS } from '../../data/reviews';
import { service } from '../../data/services';
import { href } from '../../lib/paths';
import { breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Collection };
const s = service(c.service);
const at = COLLECTIONS.indexOf(c);
const others = COLLECTIONS.length > 1 ? [1, 2, 3].map((k) => COLLECTIONS[(at + k) % COLLECTIONS.length]).filter((o, i, a) => o !== c && a.indexOf(o) === i) : [];
const path = collectionPath(c);
const KIND = { events: 'Event', products: 'Product', portraits: 'Portrait or headshot' } as const;
const review = REVIEWS.find((r) => r.collection === c.slug);

function clamp(text: string, max: number) {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(' ') > 40 ? cut.lastIndexOf(' ') : cut.length).replace(/[\s,.;:]+$/, '')}…`;
}

const brand = ' | WVR Photography';
const longTitle = `${c.title} Gallery${brand}`;
const title = longTitle.length < 25 ? `${c.title} Gallery${brand}, Fenton MI` : longTitle.length <= 70 ? longTitle : `${clamp(c.title, 70 - brand.length)}${brand}`;

const tail = 'Photographed by Matthew Weaver of WVR Photography in Fenton, MI.';
const lead = c.blurb ? `${c.blurb.replace(/[.!?]?$/, '.')} ${tail}` : `${c.title}: ${c.photos.length} ${c.photos.length === 1 ? 'photo' : 'photos'} from a ${c.kind.toLowerCase()} shoot. ${tail}`;
const description = clamp(lead.length >= 70 ? lead : `${lead} See the gallery and get a free quote.`, 160);
---

<Base title={title} description={description} path={path} schema={[breadcrumbs([{ name: 'Portfolio', path: '/portfolio/' }, { name: c.title, path }])]}>
  <PageHead user kicker={c.kind} title={c.title} lede={c.blurb || undefined} crumbs={[{ name: 'Portfolio', path: '/portfolio/' }, { name: c.title, path }]} />

  <section class="band--tight ink gal" aria-label={`${c.title} photos`}>
    <div class="wrap">
      <Gallery photos={c.photos} />
      <div class="gal__end">
        <a class="arrow" href={href('/portfolio/')}><Icon name="back" /><span>All galleries</span></a>
        <a class="btn primary" href="#quote">Book a shoot like this<Icon name="arrow" class="arr" /></a>
      </div>
    </div>
  </section>

  {
    review && (
      <section class="band white" aria-labelledby="said">
        <div class="wrap narrow">
          <SectionHead id="said" eyebrow="From the client" title="What they said." layout="left" />
          <Reviews ids={[review.id]} />
        </div>
      </section>
    )
  }

  <ContactBand title="Planning a shoot like this? Let's **talk.**" intro={`Tell me about it and I will get back to you with a free quote. More on [${s.name.toLowerCase()}](${s.path}).`} kind={KIND[c.service]} />

  {
    others.length > 0 && (
      <section class="band paper" aria-labelledby="more">
        <div class="wrap">
          <SectionHead id="more" eyebrow="Keep looking" title="More galleries." layout="left" />
          <CollectionCards items={others} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .gal {
    padding-top: 0;
  }

  .gal__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-ink);
  }

  .narrow {
    max-width: 48rem;
  }
</style>
