---
/* Layer one: the albums, at the address his Wix site used (/portfolio).
   Each album opens to its galleries; each gallery opens to its photos. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AlbumCards from '../../components/AlbumCards.astro';
import ContactBand from '../../components/ContactBand.astro';
import { ALBUMS, COLLECTIONS } from '../../data/collections';
import { breadcrumbs } from '../../lib/schema';

const photos = COLLECTIONS.reduce((n, c) => n + c.photos.length, 0);
---

<Base
  title="Galleries | WVR Photography, Fenton MI Photographer"
  description="Photo albums and galleries by WVR Photography: events, products, sports, portraits and engagements around Fenton, MI. Open an album to see its galleries."
  path="/portfolio/"
  schema={[breadcrumbs([{ name: 'Galleries', path: '/portfolio/' }])]}
>
  <PageHead
    kicker="Galleries"
    title="The work."
    lede={`${ALBUMS.length} ${ALBUMS.length === 1 ? 'album' : 'albums'}, ${COLLECTIONS.length} galleries and ${photos} photos, all from real shoots. Open an album to see its galleries.`}
    crumbs={[{ name: 'Galleries', path: '/portfolio/' }]}
  />

  <section class="band--tight ink albums" aria-label="Albums">
    <div class="wrap">
      <AlbumCards items={ALBUMS} eagerFirst />
    </div>
  </section>

  <ContactBand title="Like what you see? Let's make **yours.**" />
</Base>

<style>
  .albums {
    padding-top: 0;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
</style>
