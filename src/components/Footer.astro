---
/* The footer: the full badge, where to find him, and the Modern Apex credit. */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { BRAND, SOCIAL } from '../data/site';
import { SERVICES } from '../data/services';
import { href } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="ftr ink">
  <div class="wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href={href('/')} class="ftr__logo" aria-label={`${BRAND.name}, home`}>
          <Logo size={112} name={false} lazy />
        </a>
        <p class="muted small">Event, product and portrait photography by {BRAND.owner}, based in {BRAND.city}, {BRAND.regionName}.</p>
      </div>

      <nav aria-label="Photography">
        <p class="ftr__h">Photography</p>
        <ul>
          {SERVICES.map((s) => <li><a href={href(s.path)}>{s.name}</a></li>)}
          <li><a href={href('/portfolio/')}>Portfolio</a></li>
        </ul>
      </nav>

      <nav aria-label="About">
        <p class="ftr__h">WVR Photography</p>
        <ul>
          <li><a href={href('/about/')}>About Matthew</a></li>
          <li><a href={href('/contact/')}>Contact</a></li>
          <li><a href={href('/privacy/')}>Privacy</a></li>
        </ul>
      </nav>

      <div>
        <p class="ftr__h">Get in touch</p>
        <ul class="ftr__contact">
          <li><a href={BRAND.phoneHref}><Icon name="phone" />{BRAND.phone}</a></li>
          <li><a href={BRAND.emailHref}><Icon name="mail" />{BRAND.email}</a></li>
          <li><a href={SOCIAL.instagram} target="_blank" rel="noopener"><Icon name="instagram" />{SOCIAL.instagramHandle}</a></li>
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener"><Icon name="facebook" />WvrPhotography</a></li>
          <li class="muted"><Icon name="pin" />{BRAND.city}, {BRAND.regionName}</li>
        </ul>
      </div>
    </div>

    <div class="ftr__base fine">
      <p>© {year} {BRAND.name}. All photos by {BRAND.owner}.</p>
      <p>Website &amp; marketing by <a href="https://modernapexstrategies.com" target="_blank" rel="noopener">Modern Apex Strategies</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 0;
    border-top: 1px solid var(--line-ink);
  }

  .ftr__grid {
    display: grid;
    gap: 2.5rem;
  }

  .ftr__logo {
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .ftr__brand p {
    max-width: 22rem;
  }

  .ftr__h {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--teal-soft);
  }

  .ftr ul a,
  .ftr__contact li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    text-decoration: none;
    color: var(--on-ink);
  }

  .ftr ul a:hover {
    color: var(--teal-soft);
  }

  .ftr__contact {
    word-break: break-word;
  }

  .ftr__contact :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--teal-soft);
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-ink);
    color: var(--on-ink-muted);
  }

  .ftr__base a {
    color: var(--on-ink);
  }

  /* room for the phone bar */
  @media (max-width: 47.99rem) {
    .ftr__base {
      padding-bottom: 6rem;
    }
  }

  @media (min-width: 40rem) {
    .ftr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ftr__grid {
      grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
    }
  }
</style>
