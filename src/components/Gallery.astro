---
/* A gallery: his photos at their own shape, large, in two columns on wider
   screens and one on phones, with his caption where he wrote one. No
   lightbox: the photos are already shown big. The first two load at once
   (they are on the first screen); the rest wait until they are near. Three
   sizes per format keep a big album quick to build and small on disk. */
import Photo from './Photo.astro';
import type { GalleryPhoto } from '../data/collections';

interface Props {
  photos: GalleryPhoto[];
}
const { photos } = Astro.props;
const single = photos.length === 1;
---

<ul class:list={['gl', single && 'gl--single']}>
  {
    photos.map((p, i) => (
      <li>
        <figure>
          <Photo src={p.src} alt={p.alt} eager={i < 2} widths={[640, 1000, 1600]} sizes={single ? '(min-width: 78rem) 74rem, 100vw' : '(min-width: 78rem) 37rem, (min-width: 48rem) 48vw, 100vw'} quality={66} class="frame gl__img" />
          {p.caption && <figcaption class="fine">{p.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gl {
    columns: 1;
    column-gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  @media (min-width: 48rem) {
    .gl:not(.gl--single) {
      columns: 2;
    }
  }

  .gl li {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.75rem);
  }

  .gl figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  :global(.ink) .gl figcaption {
    color: var(--on-ink-muted);
  }
</style>
